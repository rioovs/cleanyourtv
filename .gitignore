tools/restore-this-tv.sh
tools/build-and-install-this-tv.sh
tools/tv-mirror.sh
# Perfetto traces from tools/trace.py: large, and they hold the TV's process list
traces/
.DS_Store

# Generated install bundles and JVM crash reports stay out of contributions.
*.apk
*.aab
launcher/hs_err_pid*.log
launcher/replay_pid*.log
