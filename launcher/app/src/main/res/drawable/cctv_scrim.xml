<?xml version="1.0" encoding="utf-8"?>
<!-- The dark gradient over the bottom of a camera card, so the camera name stays readable.
     Same 60% scrim as the Cinematic Video component: rgba(0,0,0,0.5) at the bottom, clear on top. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="90"
        android:startColor="#80000000"
        android:endColor="#00000000"
        android:type="linear" />
</shape>
